# I'm AiDog — credential template. Copy to `secrets.env` (same directory),
# fill the values, keep the file private (mode 0600). `secrets.env` is
# gitignored: real credentials never enter the repository.
#
# Format rules (enforced by the tooling):
#   - each key sits on its OWN line: KEY=value   (no trailing comment on the
#     value line — a value must be the only content after `=`)
#   - comments live on their own line (above the key they describe)
#   - values live ONLY here — never in argv, logs, docs, screenshots or chat
#     output; reports reference slot NAMES and counts only.
#
# Required for the full product surface (the installer reports these by name):
#
# Console write-API access token — any long random string you choose:
WEB_TOKEN=
#
# Dedicated Telegram bot token for the chat service (from @BotFather,
# format 123456:ABC-...):
MYCORE_TG_TOKEN=
#
# Comma-separated Telegram user ids allowed to talk to the bot
# (fail-closed while empty — an unauthenticated chat must never run):
AIDOG_TG_ALLOWED_USERS=
#
# API key for your OpenAI-compatible model endpoint (leave empty if it needs none):
MODEL_API_KEY=
#
# GitHub token with read access to the product repo — powers `aidog update`:
AIDOG_GH_PAT=
#
# Default chat id for cron jobs and watchdog alerts when no origin chat can
# answer (plain integer, e.g. 123456789; empty = log-only, never an error).
# Process env MYCORE_WD_CHAT wins over this slot when set:
MYCORE_WD_CHAT=

# Model endpoint: not a credential — configured in web/settings.json
# (mycore.base_url / mycore.model), default http://127.0.0.1:3460/v1 for a
# local gateway. Point it at any OpenAI-compatible endpoint you have.
#
# --- legacy / fallback slots (safe to leave empty; kept for compatibility) ---
# Old 40-char classic GitHub token; fallback only — AIDOG_GH_PAT wins:
GITHUB_PAT=
# legacy — no code reader (the product reads MYCORE_TG_TOKEN):
TG_BOT_TOKEN=
# legacy — no code reader (web/settings.json mycore.base_url is the SSOT):
MODEL_BASE_URL=
# legacy — no code reader (chain access is not implemented):
LEGACY_API_KEY=
LEGACY_POLICY_ID=

# --- optional: OpenAI-compatible API gateway token (car 4a) ---
# Bearer token required by the local /v1 gateway when you expose it; leave
# empty for loopback-only use with no auth (docs/features/openai_api_server.md).
OPENAI_API_TOKEN=

# --- optional: inbound/outbound channels (docs/features/channels.md) ---
# Configure the routes themselves in web/settings.json (channels block);
# only credentials live here. Leave empty = that channel stays off.
# Shared secret validating inbound webhook POSTs (route: webhook):
CHANNEL_WEBHOOK_SECRET=
# Discord bot token (route: discord):
CHANNEL_DISCORD_TOKEN=
# Slack app bot token (route: slack):
CHANNEL_SLACK_TOKEN=
# Email account: SMTP sending + IMAP reading (route: email):
CHANNEL_SMTP_USER=
CHANNEL_SMTP_PASS=
CHANNEL_IMAP_USER=
CHANNEL_IMAP_PASS=
# DingTalk custom bot webhook + signing secret (route: dingtalk):
CHANNEL_DINGTALK_WEBHOOK=
CHANNEL_DINGTALK_SECRET=
# Feishu app credentials (route: feishu):
CHANNEL_FEISHU_APP_ID=
CHANNEL_FEISHU_APP_SECRET=
# WeChat official-account app credentials (route: wechat):
CHANNEL_WECHAT_APPID=
CHANNEL_WECHAT_APP_SECRET=
# WhatsApp cloud API token (route: whatsapp):
CHANNEL_WHATSAPP_TOKEN=
# Signal messenger bridge token (route: signal):
CHANNEL_SIGNAL_TOKEN=

# --- optional: media BYOK slots (docs/features/tts_engines.md /
# docs/features/image_generation.md) ---
# Only needed for the BYOK TTS engine / an external image provider:
TTS_API_KEY=
IMAGE_API_KEY=

# --- optional: read-only connectors (docs/features/connectors.md) ---
LINEAR_API_KEY=
NOTION_API_KEY=

# --- optional: owner-only site deployment (aidog.im + usage stats) ---
# Leave commented out unless you deploy the site; see docs/installation.md.
#AIDOG_CF_ZONE_ID=
#AIDOG_CF_ACCOUNT_ID=
#AIDOG_CF_API_TOKEN=
# Zone-DNS record token (record ensure; separate scoped token —
# deploy_site.sh hard-fails without it):
#AIDOG_CF_DNS_TOKEN=
#AIDOG_R2_ACCESS_KEY_ID=
#AIDOG_R2_SECRET_ACCESS_KEY=
#AIDOG_R2_ENDPOINT=

# --- optional: Web3 exchange account slots (W1 reads + W2 order path) ---
# OPTIONAL: leave empty unless you enable exchange account reads
# (docs/features/exchanges.md). Public market data — the whole chain-venue
# catalog and the exchange_markets tool — is keyless and needs none of these.
# W1-vs-W2 key permissions (pick per surface, never over-grant):
#   READS (portfolio / orders / fee quotes) work with a READ-ONLY key:
#     OKX    = `Read` permission only (never Trade, never Withdraw)
#     Kraken = `Funds permissions - Query` +
#              `Orders and trades - Query open orders & trades` only
#     Binance = `USER_DATA` only (official default: a key cannot TRADE)
#   ORDERS (W2 prepare -> console approval -> execute) need MORE:
#     the same key must additionally carry the venue's TRADE permission,
#     or the venue refuses the send (honest error, plan stays retryable).
#     Enable that deliberately — and NEVER enable Withdraw permission.
# Credentials stay in this file (mode 0600) and are never echoed.
# OKX API key id — `Read` permission only, never Trade/Withdraw:
OKX_API_KEY=
# OKX API secret for that same Read-only key (never a Trade key):
OKX_API_SECRET=
# OKX API passphrase chosen at key creation for that Read-only key:
OKX_API_PASSPHRASE=
# Kraken API key — Query permissions only, never a trade/withdraw key:
KRAKEN_API_KEY=
# Kraken API secret for that same Query-only key (never a trade key):
KRAKEN_API_SECRET=
# Binance API key id — `USER_DATA` only for reads; TRADE only if you
# deliberately enable the W2 order path (never Withdrawals):
BINANCE_API_KEY=
# Binance API secret for that same key (HMAC signing stays local):
BINANCE_API_SECRET=

# --- optional: scheduled agent backup (CKX-P2, docs/features/mcp.md) ---
# Passphrase for the automated `.ckx` backup runs. It is read from THIS
# file, handed to exactly one child process environment, and never placed
# in argv, in a log line, in a response or in the model context. Losing it
# makes the scheduled backups unreadable — the same rule as the manual
# Backup & Restore card: nobody keeps a copy for you.
AIDOG_CKX_PASSWORD=
