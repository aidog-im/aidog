# Credentials never enter the repository
secrets.env
*.env
!.env.example
!secrets.env.example

# Runtime state / build output
__pycache__/
*.pyc
*.pyo
.state/
*.log
node_modules/
desktop/dist/

# Memory bundles are transport artifacts — they belong in the PRIVATE memory
# repo, never in the product repo (credential gate + publish gate still apply).
exports/

# OS noise
.DS_Store
Thumbs.db
web/settings.json
web/.voice/
.screenshots/
web/.state.json
deploy/*.local
deploy/*.local.state.json

# owner credential drops (tokens/keys land here — never tracked)
tmp/

# mycore service runtime (pidfile / service.log / sessions) — never tracked
data/

# multi-user profile runtime (each profile's secrets.env / settings / sessions)
profiles/

# pi agent local workspace (session records, agent memory, agent settings)
.pi/

# Sibling repositories moved inside this tree (owner decree 2026-10-28:
# "nothing outside this directory"). Each is an independent git repository or a
# rescue artifact; they never enter this repository, and ignoring them is what
# keeps them invisible to both git scan surfaces (ls-files and
# --exclude-standard) and to rg, which reads .gitignore by default.
aidog-internal/
aidog-skills/
aidog-public/
_public_meta/
# product-repo preservation bundle (git backup artifact), moved in with the rest
aidog-preserve-full.bundle
